            "node_6101m7mnr772ebvv4yngffvq6nan": {
                "additional_knowledge_base": [],
                "additional_prompt": "Una vez que el cliente confirme que los datos anotados son correctos, indicale de manera cálida que la administración de Vet24 se va a comunicar con él en el horario de atención de 09:00 a 21:00. Saludá amablemente usando frases cortas y naturales en español rioplatense. Finalizá la comunicación de inmediato utilizando la herramienta end_call.",
                "additional_tool_ids": [],
                "allow_interruptions_on_entry": false,
                "conversation_config": {
                    "agent": {
                        "prompt": {
                            "built_in_tools": {}
                        }
                    }
                },
                "edge_order": [],
                "entry_behavior": "auto",
                "forced_tool_name": null,
                "label": "Cierre de Llamada",
                "parent_frame_id": null,
                "parent_subgraph_id": null,
                "position": {
                    "x": 0.0,
                    "y": 534.0
                },
                "type": "override_agent"
            },
            "node_8401m7mnr770en2vmceam6290hqy": {
                "additional_knowledge_base": [],
                "additional_prompt": "Tu primer mensaje debe ser exactamente: \"Hola, te comunicaste con Vet24. La administración está cerrada en este momento. ¿En qué te puedo ayudar?\". Hablá con tono cálido, claro y usando el voseo rioplatense de Rosario, Argentina. Escuchá atentamente la respuesta: si el cliente describe una urgencia médica como que el animal no respira, sangra, convulsiona, fue atropellado, se intoxicó, no se puede levantar o si dice explícitamente que es una urgencia, debés decir exactamente \"Te paso ya con la guardia, no cortes\" y transferir inmediatamente usando la herramienta transfer_to_number al destino sip:urgencias@sip-lab.lambdaworks.ar sin hacer más preguntas. Si no es una urgencia, pasá a tomar el mensaje.",
                "additional_tool_ids": [],
