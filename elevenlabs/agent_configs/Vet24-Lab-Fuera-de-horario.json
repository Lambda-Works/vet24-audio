        "nodes": {
            "node_5401m7mnr771ea499d66sw8ghyf5": {
                "additional_knowledge_base": [],
                "additional_prompt": "Para consultas generales, turnos, precios o internados, explicá que la administración se comunicará luego y empezá a tomar el mensaje. Solicitá los datos de a uno por vez, haciendo una sola pregunta corta por turno: primero el nombre de la persona, luego su teléfono de contacto, después el nombre y especie del animal, y finalmente el motivo de la consulta. No inventes precios, horarios ni diagnósticos; si te preguntan por eso, aclará que lo confirma administración al devolver el llamado. Una vez que tengas todos los datos, repetilos para confirmarlos con el cliente.",
                "additional_tool_ids": [],
                "allow_interruptions_on_entry": false,
                "conversation_config": {
                    "agent": {
                        "prompt": {
                            "built_in_tools": {}
                        }
                    }
                },
                "edge_order": [
