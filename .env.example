# Copiar a .env y completar. Nunca subir .env al repositorio.

# --- Red ---
# IP pública del VPS (se usa en SIP/SDP como dirección externa).
PUBLIC_IP=
# FQDN del VPS con certificado confiable (obligatorio para ElevenLabs en producción).
# Si se deja vacío se usa PUBLIC_IP.
LAB_FQDN=

# --- Softphone ---
SOFTPHONE_USER=1001
# Contraseña larga y aleatoria. Evitar los caracteres ; y $.
SOFTPHONE_PASSWORD=
# PIN del buzón de voz de laboratorio (mailbox 9000).
VOICEMAIL_PIN=

# --- Identidad de la llamada ---
# Número ficticio que se presenta como Caller ID hacia los proveedores (From y P-Asserted-Identity).
LAB_CALLER_ID=+5493410000000

# --- Emulación de la regla horaria del T100 ---
# auto = según hora y feriados | night = forzar noche | day = forzar día
TIME_MODE=auto
# Horario de atención de administración (zona America/Argentina/Cordoba). Fuera de este rango es noche.
OFFICE_HOURS=09:00-20:59
# Proveedor al que se desvía la llamada de noche: openai | elevenlabs | livekit
NIGHT_PROVIDER=openai

# --- Tiempos (segundos) ---
# Espera máxima a que el proveedor conteste antes de desviar al buzón.
PROVIDER_ANSWER_TIMEOUT=20
# Espera máxima del llamante guionado a que el agente hable o termine de hablar.
AGENT_TURN_TIMEOUT=20
# Segundos que el llamante guionado espera tras oír al agente antes de interrumpirlo (frases con ">").
BARGE_DELAY=2

# --- RTP (abrir este rango UDP en el firewall) ---
RTP_START=10000
RTP_END=10199

# --- OpenAI ---
# ID del proyecto; es la parte de usuario de sip:<PROJECT_ID>@sip.api.openai.com
OPENAI_PROJECT_ID=

# --- ElevenLabs Agents ---
# Número importado en formato E.164 con "+", por ejemplo +15551234567
ELEVENLABS_NUMBER=
# Credenciales de digest de entrada (opcionales; vacío = sin autenticación).
ELEVENLABS_SIP_USER=
ELEVENLABS_SIP_PASSWORD=
# sdes (SRTP) o no (RTP plano). Debe coincidir con la opción Disabled/Allowed/Required del número.
ELEVENLABS_MEDIA_ENCRYPTION=sdes

# --- LiveKit Cloud ---
# Host SIP, por ejemplo <subdominio>.sip.livekit.cloud
LIVEKIT_SIP_HOST=
# Número E.164 configurado en el inbound trunk (parte de usuario de la URI).
LIVEKIT_NUMBER=
# Credenciales del inbound trunk (opcionales si el trunk no exige autenticación).
LIVEKIT_SIP_USER=
LIVEKIT_SIP_PASSWORD=
# sdes (SRTP) o no. Debe coincidir con la opción allow/require del trunk.
LIVEKIT_MEDIA_ENCRYPTION=sdes
